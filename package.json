{
  "name": "cornerblock-inventory",
  "version": "2.0.0",
  "private": true,
  "description": "Cloud-Based Materials Inventory Management System with Email Notification for Cornerblock Trading Inc.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "node tools/free-emulator-ports.mjs && firebase emulators:start --only firestore,auth",
    "pretest:rules": "node tools/free-emulator-ports.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project cornerblock-rules-test \"vitest run\"",
    "deploy": "npm run build && firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase-tools": "^13.29.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
