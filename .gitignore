# ============================================================
# Legacy LAN-based PHP app (kept in legacy-php/ for reference)
# ============================================================
/legacy-php/vendor/
legacy-php/config/email.config.php

# Uploaded receipt images are runtime client data, keep the folder but not its contents
legacy-php/public/uploads/receipts/*
!legacy-php/public/uploads/receipts/.gitkeep

# ============================================================
# New Firebase web app
# ============================================================
node_modules/
dist/
.firebase/
*.local

# Firebase service-account keys must never be committed. The migration
# script reads its key from a path outside this repo.
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json

# Local emulator and CLI state
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebaserc.local

# ============================================================
# General
# ============================================================
*.log
.DS_Store
Thumbs.db

# ============================================================
# Data migration
# The dump is the client's real catalog, and the plan is built from it.
# Neither belongs in version control. Only the empty folders are kept.
# ============================================================
tools/migrate/input/*
!tools/migrate/input/.gitkeep
tools/migrate/output/*
!tools/migrate/output/.gitkeep
